{
  "cli": {
    "version": ">= 20.3.0",
    "appVersionSource": "remote"
  },
  "build": {
    "preview-sim": {
      "distribution": "internal",
      "ios": {
        "simulator": true
      },
      "channel": "preview-sim"
    },
    "preview-apk": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "channel": "preview-apk"
    },
    "production": {
      "distribution": "store",
      "channel": "production",
      "autoIncrement": true,
      "android": {
        "buildType": "app-bundle"
      },
      "ios": {
        "buildConfiguration": "Release"
      }
    }
  },
  "submit": {
    "closed-test": {
      "android": {
        "serviceAccountKeyPath": "./credentials/play-service-account.json",
        "track": "alpha",
        "releaseStatus": "completed"
      }
    },
    "production": {
      "android": {
        "serviceAccountKeyPath": "./credentials/play-service-account.json",
        "track": "production",
        "releaseStatus": "completed"
      },
      "ios": {
        "appleId": "aleksandrasabrutis18@gmail.com",
        "ascAppId": "6796757249",
        "appleTeamId": "292X7P792G"
      }
    }
  }
}
